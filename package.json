{
  "name": "seaq-monorepo",
  "private": true,
  "version": "2.0.0",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "test": "yarn workspaces foreach -A run test",
    "coverage": "yarn workspace @billie-coop/seaq test:coverage",
    "report": "yarn workspace @billie-coop/seaq report",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ts-check": "tsc --build --incremental",
    "dev": "yarn workspace @billie-coop/seaq build && (yarn workspace @billie-coop/seaq dev & yarn workspace @seaq/docs dev & wait)",
    "clean": "rm -rf .tsc-out packages/*/dist",
    "bench:save": "yarn workspace @billie-coop/seaq bench:save",
    "release:verify": "yarn ts-check && yarn check && yarn test && yarn coverage && yarn build",
    "release:pack": "cd packages/core && npm pack --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@vitest/coverage-v8": "^4.0.18",
    "seaq-v1": "npm:seaq@1.1.5",
    "typescript": "^5.9.3"
  }
}
